# Optional overrides only — the app runs fully local with no keys.
# PORT=3000
# DATA_DIR=

# Asset prices are manual: record them in the price dialog or via the MCP
# save_price tool. Price providers (Alpha Vantage, Marketstack), price sync,
# backfill, symbol search, and NAV file import were removed. Historical FX sync
# uses Frankfurter, which needs no key.

# No configuration needed for the MCP endpoint (for agents like Nous Research Hermes):
# it serves at /mcp, unauthenticated and writable by design, reachable only from this
# machine because the app binds to 127.0.0.1. See README "MCP server".
